{
  "name": "creative-skills-kit",
  "version": "0.1.2",
  "private": true,
  "description": "An installable kit of creative skills and coding standards: a Node.js CLI installer/validator plus a Next.js web registry and catalog.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "csk": "node packages/cli/bin/csk.js"
  },
  "engines": {
    "node": ">=18"
  }
}
